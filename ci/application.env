# Réglages non secrets des tests Jenkins du backend (ecc-devops, étape tests). Les secrets sont des fichiers montés
# dans l'agent (ecc-devops/scripts/Initialize-TestRuntime.ps1), lus par FileAwareEnv : VARIABLE_FILE l'emporte.
# Pas de Redis en CI : les tests du cache et de Celery fixent eux-mêmes leurs réglages (locmem, mode eager).
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY_FILE=/run/secrets/ci/django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
POSTGRES_DB=cst_ci
POSTGRES_USER=seme_ci
POSTGRES_PASSWORD_FILE=/run/secrets/ci/db-password
POSTGRES_HOST=ci-db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CST/CSMO <noreply@ecc.test>
EMAIL_TIMEOUT=10
CONTACT_NOTIFICATION_EMAILS=
CONTACT_RATE_LIMIT_COUNT=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
CELERY_WORKER_PREFETCH_MULTIPLIER=1
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PENDING_SESSION_MINUTES=10
BACKOFFICE_SESSION_MAX_AGE=28800
BACKOFFICE_LOGIN_MAX_ATTEMPTS=5
BACKOFFICE_LOGIN_IP_MAX_ATTEMPTS=25
BACKOFFICE_LOGIN_WINDOW_MINUTES=15
BACKOFFICE_LOGIN_LOCKOUT_MINUTES=15
MAX_IMAGE_UPLOAD_MB=30
MAX_DOCUMENT_UPLOAD_MB=100
GALLERY_CHUNK_SIZE_MB=8
GALLERY_MAX_ORIGINAL_IMAGE_MB=150
GALLERY_MAX_FILES_PER_SELECTION=200
GALLERY_UPLOAD_SESSION_TTL_HOURS=24
