# syntax=docker/dockerfile:1

# =============================================================
# Dockerfile.prod — Frontend CST Next.js
# Production uniquement
# Mode : Next.js standalone
# =============================================================

# Image épinglée par digest (la même que SEME) : la rafraîchir délibérément, puis rescanner.
ARG NODE_IMAGE=node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

FROM ${NODE_IMAGE} AS deps

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./

RUN npm ci --no-audit --no-fund


FROM ${NODE_IMAGE} AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# Les variables NEXT_PUBLIC_* sont intégrées au moment du build Next.js.
ARG NEXT_PUBLIC_SITE_URL=https://cst.ecc.bj
ARG NEXT_PUBLIC_API_URL=http://cst-backend:8000/api/v1
ARG NEXT_PUBLIC_DATA_SOURCE=mock
ARG NEXT_PUBLIC_NEWS_SOURCE=api
ARG NEXT_PUBLIC_GALLERY_SOURCE=api
ARG NEXT_PUBLIC_DOCUMENTS_SOURCE=api

ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_DATA_SOURCE=$NEXT_PUBLIC_DATA_SOURCE
ENV NEXT_PUBLIC_NEWS_SOURCE=$NEXT_PUBLIC_NEWS_SOURCE
ENV NEXT_PUBLIC_GALLERY_SOURCE=$NEXT_PUBLIC_GALLERY_SOURCE
ENV NEXT_PUBLIC_DOCUMENTS_SOURCE=$NEXT_PUBLIC_DOCUMENTS_SOURCE

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build


FROM ${NODE_IMAGE} AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Le serveur standalone n'a besoin que de node : npm, yarn et corepack livrés avec l'image
# ne servent pas à l'exécution et portent leurs propres CVE. Utilisateur non-root dédié au projet CST.
RUN rm -rf /usr/local/lib/node_modules /opt/yarn* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -g 1001 -S cstgroup \
    && adduser -S -D -H -u 1001 -G cstgroup cstuser

# Le code appartient à root et reste en lecture seule pour cstuser ; seul le cache de Next
# (optimisation des images) lui est accessible en écriture.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
RUN mkdir -p .next/cache && chown cstuser:cstgroup .next/cache

USER cstuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD node -e "fetch('http://127.0.0.1:3000').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
